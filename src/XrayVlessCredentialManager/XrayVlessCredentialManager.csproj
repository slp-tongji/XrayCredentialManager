<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CliFx" Version="3.0.1" />
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
        <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
        <PackageReference Include="LiteDB" Version="5.0.21" />
        <PackageReference Include="Tjslp.CredentialManager.Protocol" Version="0.0.1" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\common\**\*.proto" ProtoRoot="Protos" GrpcServices="None" />
        <Protobuf Include="Protos\proxy\**\*.proto" ProtoRoot="Protos" GrpcServices="None" />
        <Protobuf Include="Protos\app\**\*.proto" ProtoRoot="Protos" GrpcServices="Client" />
    </ItemGroup>

</Project>
